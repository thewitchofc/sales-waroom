# Public app URL (used for metadata, OG tags, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (server-side only, never expose to the client)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_ARENA_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE_CUSTOMER=coral
OPENAI_TTS_VOICE_COACH=onyx

# Node environment (set automatically by Next.js in production)
# NODE_ENV=production
